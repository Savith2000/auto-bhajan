# Sai Tunes External API credentials.
# Copy to .env and fill in. Never commit .env.

# OAuth2 client credentials issued by the Sai Tunes team
SAITUNES_CLIENT_ID=
SAITUNES_CLIENT_SECRET=

# Cognito token endpoint. The published docs leave the domain prefix blank
# (https://.auth.us-east-1.amazoncognito.com/...), so ask the Sai Tunes team
# for it, e.g. https://<prefix>.auth.us-east-1.amazoncognito.com/oauth2/token
SAITUNES_TOKEN_URL=

SAITUNES_SCOPE=https://api.saitunes.com/read

# Live API base (the docs mention api.saitunes.com, but only .org resolves)
SAITUNES_API_BASE=https://api.saitunes.org
