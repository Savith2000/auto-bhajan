{
  "name": "autobhajan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ort-wasm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ort-wasm.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "catalog": "python3 scripts/fetch_catalog.py && node scripts/english-devanagari.ts",
    "eval:openings": "node eval/openings.ts",
    "eval:transcribe": "node eval/transcribe.ts",
    "eval:score": "node eval/score.ts",
    "catalog:offline": "python3 scripts/fetch_catalog.py --offline && node scripts/english-devanagari.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
